[Unit]
Description=SmartOdds Basketball Backend
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/opt/SmartOddsBasketball/backend
EnvironmentFile=/opt/SmartOddsBasketball/.env
ExecStart=/opt/SmartOddsBasketball/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8002
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
