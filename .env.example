# ================================================================
# SmartOdds Basketball — variables de entorno (.env vive en la raiz)
# Copia este fichero a .env y rellena los valores.
# ================================================================

# Database (SQLite en dev, PostgreSQL en prod)
DATABASE_URL=sqlite:///smartodds_basketball.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/smartodds_basketball

# Auth
SECRET_KEY=change-me-to-secure-random-string

# The Odds API (misma clave que tenis/futbol)
ODDS_API_KEY=
ODDS_API_REGIONS=us,eu,uk
ODDS_API_MARKETS=h2h

# Basketball Scores API (TODO confirmar proveedor)
BASKETBALL_SCORES_API_KEY=

# BetsAPI (scores + ODDS de ligas fuera de The Odds API) — token compartido
BETSAPI_TOKEN=
# Ingesta de odds via BetsAPI (ACB, etc.). true/false.
BETSAPI_ODDS_ENABLED=true
# Ligas a incluir (substrings del nombre de liga en BetsAPI), separadas por coma
BETSAPI_LEAGUES=ACB,Spain

# BetBurger (ingesta de odds desde VPS XL)
BETBURGER_INGEST_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=SmartOdds Basket <noreply@smartoddsbasket.es>
APP_BASE_URL=https://smartoddsbasket.es
DISCORD_INVITE_URL=

# PayPal (suscripciones)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=
PAYPAL_PRICE_MONTHLY=49.99
PAYPAL_PRICE_ANNUAL=499

# Modo prueba (dias de free trial al registrarse, 0 = off)
TRIAL_DAYS=14

# Scheduler
ODDS_UPDATE_INTERVAL_MINUTES=15
SCORES_UPDATE_INTERVAL_MINUTES=5

# Ligas monitorizadas (sport_keys de The Odds API)
MONITORED_LEAGUES=basketball_nba,basketball_euroleague,basketball_ncaab,basketball_wnba

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
